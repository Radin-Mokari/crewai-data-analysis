# Leave unset to use Vite dev proxy: /api → http://127.0.0.1:8765 (see vite.config.ts)
# For a direct backend URL (no proxy), e.g. production or custom port:
# VITE_API_BASE_URL=http://127.0.0.1:8765

# SSE (Server-Sent Events) streams always bypass the Vite proxy and connect
# directly to the FastAPI server to avoid http-proxy response buffering.
# Override the port if your server runs on a non-default port:
# VITE_API_PORT=8765
