GEMINI_API_KEY=place-gemini-api-key-here
# this should be edited with the name of the input dataset
DATASET_PATH=Dataset.csv
OUTPUT_DIR=./analysis_results
AGENTOPS_API_KEY=place-agentops-api-key-here

# Dynamic supervisor (default): WORKFLOW_MODE=dynamic | sequential
WORKFLOW_MODE=dynamic
USER_ANALYSIS_PROMPT=Perform thorough exploratory analysis and preprocessing; highlight issues and modeling recommendations.
# Optional: absolute or relative path to an existing run folder (e.g. analysis_results/run_20260101_120000)
# RESUME_RUN_DIR=
# Or resume by timestamp id (folder must exist under OUTPUT_DIR):
# RESUME_RUN_ID=20260101_120000

# Optional: one extra user message for dynamic mode (merged into supervisor chat once per run)
# USER_FOLLOWUP=Focus on median house value as target

# DYNAMIC_MAX_STEPS=18
# DYNAMIC_STEP_DELAY_SECONDS=2
# MANAGER_CHAT_BUDGET_CHARS=28000
# MANAGER_CHAT_KEEP_RECENT=14

# Interactive-first (default): stdin sets goal before any supervisor batch. Set 0 for env-driven batch then stdin.
# INTERACTIVE_FIRST=1
# Batch-first: full supervisor run from USER_ANALYSIS_PROMPT before stdin (or use: python run.py --batch-first)
# AUTO_RUN_SUPERVISOR=0
# Skip final markdown file write after interactive-first unless report content exists or you set 1:
# AUTO_MARKDOWN_REPORT=0

# After dynamic run: stdin manager chat is ON by default (same kernel + manager_chat.jsonl).
# Set INTERACTIVE_SESSION=0 or use: python run.py --no-interactive  to exit immediately after the report.
# INTERACTIVE_SESSION=
# Cap total manager JSON calls (including CHAT); 0 = unlimited
# INTERACTIVE_MAX_MANAGER_TURNS=0

# Persist df_* + metadata after each specialist step (default on). Set 0 to disable.
# SESSION_SNAPSHOT=1

# Local server (server.py / uvicorn)
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8765
# Comma-separated origins for browser clients (e.g. Vite on 8080). Default includes localhost:8080 if unset.
# CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Optional caps for HTTP JSON payloads (defaults shown)
# CHAT_EXCERPT_MAX_CHARS=12000
# RUN_HISTORY_EXCERPT_MAX_CHARS=16000
# REPORT_MARKDOWN_MAX_CHARS=200000

# Supervisor digest (passed to manager each turn — too small causes false "incomplete" re-runs)
# SUPERVISOR_DIGEST_LAST_N=10
# SUPERVISOR_DIGEST_EXCERPT_CHARS=4000
# SUPERVISOR_DIGEST_INSTRUCTION_CHARS=800
# Stop repeated reporter / cleaning loops in one user turn
# MAX_REPORTER_INVOCATIONS_PER_SEGMENT=1
# MAX_CLEANING_INVOCATIONS_PER_SEGMENT=2
# SAME_AGENT_REPEAT_MAX=3

