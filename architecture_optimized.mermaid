%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#fff', 'primaryTextColor': '#111', 'primaryBorderColor': '#888', 'lineColor': '#555', 'secondaryColor': '#f5f5f5', 'tertiaryColor': '#fff', 'clusterBkg': '#fafafa', 'clusterBorder': '#bbb', 'edgeLabelBackground': '#fff', 'fontSize': '13px'}, 'flowchart': {'nodeSpacing': 30, 'rankSpacing': 50, 'curve': 'basis'}}}%%

flowchart LR

    %% ════════════════════════════════════
    %% COLUMN 1: USER + FRONTEND
    %% ════════════════════════════════════
    subgraph COL1["React Frontend · Dark Theme"]
        direction TB
        USER(["👤 User\nCSV + Prompt"])
        USER --> F_PROMPT["Prompt Island\nfull analysis request"]
        USER --> F_AGENT["Agent Buttons\n🧹 Clean · 📊 EDA · 🎨 Viz\n📐 Stats · 🔧 Feature · ⚖️ Imbalance\n📝 Report"]
        USER --> F_SIDE["Session Sidebar"]
        F_CHAT["Chat Section"]
        F_KERN["Kernel View\nNotebook-style cells\nper-agent code + output"]
        F_LOGS["Process Logs"]
    end

    %% ════════════════════════════════════
    %% COLUMN 2: WEB LAYER
    %% ════════════════════════════════════
    subgraph COL2["FastAPI · main.py"]
        direction TB
        API["/upload\n/analyze\n/sessions\n/results"]
        API_AGENT["/agent/run\nagent_name + prompt"]
        WS["WebSocket\nManager"]
    end

    %% ════════════════════════════════════
    %% COLUMN 3: ORCHESTRATION
    %% ════════════════════════════════════
    subgraph COL3["Orchestration · orchestrator.py"]
        direction TB

        INS["🔍 Inspection\nLoad CSV → Profile\n· Deterministic, no LLM ·\n· Skipped if already done ·"]

        subgraph REACT_LOOP["Path A — Manager ReAct Loop"]
            direction TB
            OBS["OBSERVE\n_build_snapshot"]
            THK["THINK\n_ask_manager"]
            DEC{{"DECIDE"}}
            OBS --> THK --> DEC
        end

        DEC -->|"DELEGATE\n+ instructions"| CTX
        DEC -->|"all done"| DONE(["✅ COMPLETE"])

        DIRECT["Path B — Direct Execution\nrun_single_specialist()\nuser picks agent + prompt"]

        DIRECT --> CTX

        subgraph CTX_BOX["Context Injection · _run_specialist"]
            direction TB
            CTX["Inject Prior Findings\n+ State Validation Prefix\n→ Build Enriched Task"]
        end

        CAP["📸 CAPTURE\nStore summary"]

        subgraph QG_BOX["Quality Gate · _evaluate_quality"]
            direction TB
            QG{{"Errors? Empty?\nKernel valid?"}}
            QG -->|"✅ Pass"| QG_OK["PASS"]
            QG -->|"❌ Fail"| QG_REDO["REDO\nmax 2/agent\nmax 5 total"]
        end
    end

    %% ════════════════════════════════════
    %% COLUMN 4: SPECIALISTS (7)
    %% ════════════════════════════════════
    subgraph COL4["Specialists · agents.py"]
        direction TB
        AG_CLN["🧹 Data Cleaning"]
        AG_EDA["📊 EDA"]
        AG_VIZ["🎨 Visualization"]
        AG_STA["📐 Statistics"]
        AG_FE["🔧 Feature Engineering"]
        AG_IMB["⚖️ Class Imbalance"]
        AG_RPT["📝 Report"]
    end

    %% ════════════════════════════════════
    %% COLUMN 5: JUPYTER KERNEL + STATE + STORAGE
    %% ════════════════════════════════════
    subgraph COL5["Jupyter Kernel + State · tools.py"]
        direction TB

        subgraph JUPYTER["IPython Kernel · jupyter_client"]
            EXEC["⚙️ JupyterSessionTool\nKernelManager · execute_interactive\nOne cell per agent execution\nShared persistent session"]
            CELLS["Cell History\ncell_id · agent · code\nstdout · stderr · images\nexecution_count"]
        end

        subgraph DUAL["Session State — Dual Layer"]
            direction TB
            S_KERN["Layer 1: Kernel Namespace\ndf_raw · df_clean · df_features\nNUMERIC / CATEGORICAL_COLUMNS\nPersisted across all cells"]
            S_TASK["Layer 2: Task Summaries\nPer-specialist text findings"]
        end

        subgraph STORE["Persistence · database.py"]
            direction TB
            DB[("SQLite\nSessions")]
            FS[("Files\nCharts\nReports")]
        end
    end

    %% ════════════════════════════════════
    %% PATH A: Full Analysis (Manager-driven)
    %% ════════════════════════════════════
    F_PROMPT -->|"full\nanalysis"| API
    API -->|"background\ntask"| INS
    INS -->|"profile\nJSON"| OBS

    %% ════════════════════════════════════
    %% PATH B: Direct Agent Execution
    %% ════════════════════════════════════
    F_AGENT -->|"agent_name\n+ prompt"| API_AGENT
    API_AGENT -->|"background\ntask"| INS
    INS -->|"profile"| DIRECT

    %% ════════════════════════════════════
    %% SHARED: Context → Specialists → Kernel
    %% ════════════════════════════════════
    CTX --> COL4
    COL4 -->|"code\n→ new cell"| EXEC

    %% Specialists → Capture → Quality
    COL4 --> CAP
    CAP --> QG

    %% ════════════════════════════════════
    %% FEEDBACK LOOPS
    %% ════════════════════════════════════
    QG_OK -->|"Path A:\nloop back"| OBS
    QG_OK -->|"Path B:\ndone"| DONE
    QG_REDO -->|"retry"| CTX

    %% State writes
    CAP -->|"store\nsummary"| S_TASK
    EXEC -->|"variables\npersist in\nkernel namespace"| S_KERN
    EXEC -->|"append\ncell"| CELLS

    %% State reads
    S_TASK -.->|"prior\nfindings"| CTX
    S_KERN -.->|"available\nvars"| CTX
    S_TASK -.->|"snapshot"| OBS

    %% Sidebar
    F_SIDE -->|"load\nsession"| API

    %% Persistence
    S_TASK -->|"on\ncomplete"| DB
    CAP --> FS

    %% Final output
    DONE --> API
    DONE --> API_AGENT
    API --> F_CHAT
    API_AGENT --> F_CHAT

    %% ════════════════════════════════════
    %% WEBSOCKET
    %% ════════════════════════════════════
    OBS -.->|"thoughts"| WS
    QG -.->|"quality"| WS
    EXEC -.->|"cell_update\ncell_id · agent\ncode · outputs\nimages"| WS
    DIRECT -.->|"progress"| WS
    WS -.->|"events"| F_CHAT
    WS -.->|"events"| F_KERN
    WS -.->|"events"| F_LOGS

    %% ════════════════════════════════════
    %% STYLES
    %% ════════════════════════════════════
    classDef default fill:#fff,stroke:#999,color:#111
    classDef usr fill:#f0f0f0,stroke:#666,color:#111,stroke-width:1.5px
    classDef fe fill:#dbeafe,stroke:#3b82f6,color:#111
    classDef api fill:#dcfce7,stroke:#22c55e,color:#111
    classDef inspect fill:#e0e7ff,stroke:#6366f1,color:#111
    classDef mgr fill:#ede9fe,stroke:#8b5cf6,color:#111
    classDef dec fill:#fefce8,stroke:#ca8a04,color:#111,stroke-width:2px
    classDef ctx fill:#fef9c3,stroke:#eab308,color:#111,stroke-width:1.5px
    classDef agent fill:#fce7f3,stroke:#ec4899,color:#111
    classDef exec fill:#fff7ed,stroke:#f97316,color:#111
    classDef qgS fill:#fee2e2,stroke:#ef4444,color:#111
    classDef pass fill:#dcfce7,stroke:#22c55e,color:#111,stroke-width:1.5px
    classDef state fill:#ccfbf1,stroke:#14b8a6,color:#111
    classDef db fill:#f3f4f6,stroke:#6b7280,color:#111
    classDef done fill:#dcfce7,stroke:#16a34a,color:#111,stroke-width:2px
    classDef directS fill:#e0f2fe,stroke:#0284c7,color:#111,stroke-width:1.5px
    classDef jupyter fill:#fef3c7,stroke:#d97706,color:#111,stroke-width:1.5px

    class USER usr
    class F_PROMPT,F_SIDE,F_CHAT,F_KERN,F_LOGS,F_AGENT fe
    class API,API_AGENT,WS api
    class INS inspect
    class OBS,THK mgr
    class DEC dec
    class CTX ctx
    class AG_CLN,AG_EDA,AG_VIZ,AG_STA,AG_FE,AG_IMB,AG_RPT agent
    class EXEC,CELLS jupyter
    class CAP,QG,QG_REDO qgS
    class QG_OK pass
    class S_KERN,S_TASK state
    class DB,FS db
    class DONE done
    class DIRECT directS
